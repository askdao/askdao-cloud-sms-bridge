# === SMS bridge: environment ===
# Copy to .env in the install directory (the service's working directory) and edit.
# Read once at startup: restart the service after changing it.

# WebSocket port conductor connects to (through the tunnel).
BRIDGE_PORT=3003

# Shared token conductor sends in its auth frame (required). Generate one with:
#   openssl rand -hex 32
# and put the same value in conductor's settings.
BRIDGE_TOKEN=

# Read-only token for tests and watching (optional; must differ from BRIDGE_TOKEN). A connection
# that authenticates with it gets every frame conductor gets and may not send commands.
BRIDGE_OBSERVER_TOKEN=

# Session file written by `sms-bridge pair` and kept up to date by `sms-bridge serve`.
# It is a live login to the Google account (mode 0600): never copy it into the repository.
# Relative paths are relative to the working directory.
BRIDGE_SESSION_FILE=session.json

# Google Chrome binary that draws send_image frames (pictures from HTML). The bridge starts it
# headless with a throwaway profile; your own Chrome profiles are never touched.
# Default: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BRIDGE_CHROME_PATH=

# Delivery state for the seq_ack protocol: outbound progress per conversation and inbound
# messages conductor has not confirmed yet (it holds message text; mode 0600). Relative paths
# are relative to the working directory.
BRIDGE_STATE_FILE=delivery.json

# Held inbound messages are sent again to a reconnecting conductor for this many minutes.
BRIDGE_INBOUND_REPLAY_MINUTES=30

# Edge node (conductor's heartbeat monitor). `sms-bridge enroll <code>` writes the identity
# file (it holds the node token; mode 0600); while it exists, serve sends a heartbeat every minute.
# Conductor's API address (the same host conductor's web API answers on), e.g. https://api.example.com
EDGE_CONDUCTOR_URL=
EDGE_IDENTITY_FILE=edge-node.json
