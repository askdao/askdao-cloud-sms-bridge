# === SMS bridge: environment ===
# Copy to .env in the install directory (the service's working directory) and edit.
# Read once at startup: restart the service after changing it.

# Session file written by `sms-bridge pair` and kept up to date by `sms-bridge serve`.
# It is a live login to the Google account (mode 0600): never copy it into the repository.
# Relative paths are relative to the working directory.
BRIDGE_SESSION_FILE=session.json
